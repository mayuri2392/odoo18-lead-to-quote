<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quote_from_lead_wizard_form" model="ir.ui.view">
        <field name="name">quote.from.lead.wizard.form</field>
        <field name="model">quote.from.lead.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Quotation from Lead">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="partner_id"/>
                    <field name="create_partner_if_missing"/>
                    <field name="validity_date"/>
                </group>
                <notebook>
                    <page string="Lines">
                        <field name="product_line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="price_unit"/>
                            </list>
                        </field>
                    </page>
                    <page string="Note">
                        <field name="note"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_quote"
                            type="object"
                            string="Create Quotation"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>